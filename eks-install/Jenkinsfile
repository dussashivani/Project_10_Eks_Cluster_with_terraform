pipeline {
    agent any

    environment {
        AWS_DEFAULT_REGION = 'us-east-1'
   }

    stages {

        stage('CLONE SCM') {
            steps {
                echo 'Cloning code from GitHub...'

                git branch: 'main',
                    url: 'https://github.com/dussashivani/Project_10_Eks_Cluster_with_terraform.git'
            }
        }

        stage('CHECK TERRAFORM') {
            steps {
                sh '''
                    echo "Checking Terraform installation..."
                    terraform --version
                '''
            }
        }

        stage('CHECK AWS') {
            steps {
                sh '''
                    echo "Checking AWS credentials..."
                    aws sts get-caller-identity
                '''
            }
        }

        stage('CREATE REMOTE BACKEND') {
            steps {
                sh '''
                    echo "Creating S3 bucket and DynamoDB table..."

                    cd eks-install/backend

                    terraform init
                    terraform validate
                    terraform plan
                    terraform apply -auto-approve
                '''
            }
        }

        stage('TERRAFORM INIT') {
            steps {
                sh '''
                    echo "Initializing EKS Terraform configuration..."

                    cd eks-install
                    terraform init
                '''
            }
        }

        stage('TERRAFORM VALIDATE') {
            steps {
                sh '''
                    cd eks-install
                    terraform validate
                '''
            }
        }

        stage('TERRAFORM PLAN') {
            steps {
                sh '''
                    cd eks-install
                    terraform plan -out=tfplan
                '''
            }
        }

        stage('TERRAFORM APPLY') {
            steps {
                sh '''
                    cd eks-install
                    terraform apply -auto-approve tfplan
                '''
            }
        }

        stage('TERRAFORM OUTPUT') {
            steps {
                sh '''
                    cd eks-install
                    terraform output
                '''
            }
        }
    }

    post {
        success {
            echo 'Terraform deployment completed successfully!'
        }

        failure {
            echo 'Terraform deployment failed. Check the Jenkins console output.'
        }

        always {
            echo 'Pipeline finished.'
        }
    }
}




